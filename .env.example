# Isi nilai ini di Vercel → Project Settings → Environment Variables
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Wajib untuk API event dan data situs di Vercel; arahkan ke proyek yang sama.
# Gunakan publishable key, bukan secret/service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Adapter server Vercel
NITRO_PRESET=vercel
# Opsional: "true" untuk menampilkan halaman maintenance
VITE_MAINTENANCE_MODE=
